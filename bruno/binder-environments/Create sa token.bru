meta {
  name: Create sa token
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/binder-environments/
  body: json
  auth: apikey
}

auth:apikey {
  key: Authorization
  value: Token {{saToken}}
  placement: header
}

body:json {
  {
    "binder_ref": "{{binder_ref}}"
  }
}

script:post-response {
  try {
    const uuid = res.getBody().url.replace(/.*\/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\/$/, "$1")
    bru.setVar('env-1-uuid', uuid)
  }
  catch (e) {
    console.log(e)
  }
}

tests {
  test("Status code is 201", function () {
      expect(res.getStatus()).to.equal(201);
  });
}
