meta {
  name: List by label
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/virtual-labs/?labels=label-1
  body: none
  auth: bearer
}

params:query {
  labels: label-1
}

auth:bearer {
  token: {{ourJWT}}
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  test("JSON response is valid", function () {
      var jsonData = res.getBody();
      expect(jsonData.count).to.eq(1);
  });
}
