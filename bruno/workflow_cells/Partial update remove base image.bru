meta {
  name: Partial update remove base image
  type: http
  seq: 46
}

patch {
  url: {{baseUrl}}/workflow-cells/{{binderEnvironmentCellUUID}}/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ourJWT}}
}

body:json {
  {
    "base_container_image": {
      "binder_environment": ""
    }
  }
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("base_container_image is valid", function () {
    expect(res.getBody().base_container_image).to.deep.equal({"build": "", "runtime": ""});
  });
}
