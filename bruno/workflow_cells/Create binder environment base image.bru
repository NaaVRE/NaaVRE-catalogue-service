meta {
  name: Create binder environment base image
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/workflow-cells/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ourJWT}}
}

body:json {
  {
    "virtual_lab": "test-virtual-lab-1",
    "title": "test-cell-binder-environment",
    "description": "",
    "template_format": "v1",
    "container_image": "test-image-binder-environment",
    "base_container_image": {
      "binder_environment": "ghcr.io/naavre/vl-openlab:abc123"
    },
    "kernel": "",
    "source_url": ""
  }
}

script:post-response {
  const uuid = res.getBody().url.replace(/.*\/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\/$/, "$1")
  bru.setVar('binderEnvironmentCellUUID', uuid)
}

tests {
  test("Status code is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("base_container_image is valid", function () {
    expect(res.getBody().base_container_image).to.deep.equal({"binder_environment": "ghcr.io/naavre/vl-openlab:abc123"});
  });
}
