meta {
  name: Retrieve binder environment base image after update to flavor
  type: http
  seq: 33
}

get {
  url: {{baseUrl}}/workflow-cells/{{binderEnvironmentCellUUID}}/
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ourJWT}}
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("base_container_image is valid", function () {
    expect(res.getBody().base_container_image).to.deep.equal({"build": "test-build-binder-environment", "runtime": "test-runtime-binder-environment"});
  });
}
