meta {
  name: Create invalid base image both shapes
  type: http
  seq: 37
}

post {
  url: {{baseUrl}}/workflow-cells/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ourJWT}}
}

body:json {
  {
    "virtual_lab": "test-virtual-lab-1",
    "title": "test-cell-binder-environment",
    "description": "",
    "template_format": "v1",
    "container_image": "test-image-binder-environment",
    "base_container_image": {
      "build": "test-build-binder-environment",
      "runtime": "test-runtime-binder-environment",
      "binder_environment": "ghcr.io/naavre/vl-openlab:abc123"
    },
    "kernel": "",
    "source_url": ""
  }
}

tests {
  test("Status code is 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("Error is reported on base_container_image", function () {
    expect(res.getBody()).to.have.property("base_container_image");
  });
}
