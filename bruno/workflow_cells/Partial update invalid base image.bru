meta {
  name: Partial update invalid base image
  type: http
  seq: 41
}

patch {
  url: {{baseUrl}}/workflow-cells/{{binderEnvironmentCellUUID}}/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ourJWT}}
}

body:json {
  {
    "base_container_image": {
      "build": "test-build-binder-environment",
      "runtime": "test-runtime-binder-environment",
      "binder_environment": "ghcr.io/naavre/vl-openlab:abc123"
    }
  }
}

tests {
  test("Status code is 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("Error is reported on base_container_image", function () {
    expect(res.getBody()).to.have.property("base_container_image");
  });
}
