meta {
  name: Create cell-2 (completed, success)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/workflow-cells/
  body: json
  auth: inherit
}

body:json {
  {
    "virtual_lab": "test-virtual-lab-1",
    "title": "cell-2",
    "container_image": "image",
    "containerization_job": {
      "html_url": "https://example.com/",
      "status": "completed",
      "conclusion": "success"
    },
    "containerization_workflow_id": "6cfc312b-4ed9-491c-b58d-a299faea0df1"
  }
}

script:post-response {
  try {
    const uuid = res.getBody().url.replace(/.*\/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\/$/, "$1")
    bru.setVar('cell-2-uuid', uuid)
  }
  catch (e) {
    console.log(e)
  }
}

tests {
  test("Status code is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("JSON response is valid", function () {
    var jsonData = res.getBody();
    expect(jsonData).to.deep.include({
      "containerization_job": {
        "html_url": "https://example.com/",
        "status": "completed",
        "conclusion": "success"
      },
    });
  });
}
