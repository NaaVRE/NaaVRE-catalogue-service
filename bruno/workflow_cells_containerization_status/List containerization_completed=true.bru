meta {
  name: List containerization_completed=true
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/workflow-cells/?containerization_completed=true
  body: none
  auth: inherit
}

params:query {
  containerization_completed: true
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  test("JSON response is valid", function () {
      var jsonData = res.getBody();
      expect(jsonData.count).to.eq(1);
      expect(jsonData.results[0].title).to.eq("cell-2");
  });
}
